# Copy to .env and fill in locally. Never commit real keys.
# The CLI reads this file without adding the keys to the process environment,
# so they never reach prompts, logs, checks or git in a run workspace.

# Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=

# Rehearsals: a local fake API. Leave unset for the Meta Model API. The key is
# sent to this address.
# MODEL_API_BASE_URL=http://127.0.0.1:8787/v1
# Keeps rehearsal runs and their spend apart from the real ones.
# REPOD_RUNS_DIR=runs/rehearsal

# Meta's open-weight models on OpenRouter instead of the Meta Model API
# (see README): put the OpenRouter key in MODEL_API_KEY and set
# MODEL_API_BASE_URL=https://openrouter.ai/api/v1
# REPOD_CONFIG_DIR=config/open-weights

# Anthropic API (only needed if a preset uses a Claude model)
ANTHROPIC_API_KEY=
