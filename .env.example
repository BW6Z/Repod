# Copy to .env and fill in locally. Never commit real keys.
# Keys are read only by the model gateway; they are never placed in prompts,
# logs, or the environment of child processes that run checks.

# Meta Model API (https://api.meta.ai/v1)
MODEL_API_KEY=

# Anthropic API (only needed if a preset uses a Claude model)
ANTHROPIC_API_KEY=
