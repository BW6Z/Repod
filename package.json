{
  "name": "repod",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Meta-coordinated multi-model development assistant (prototype).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p sample-repo/tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:sample": "node --test \"sample-repo/test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run test:sample",
    "repod": "node src/cli/main.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
